# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=demodemo
NEO4J_DATABASE=neo4j

# OpenAI (embeddings + LLM for the GraphRAG sections)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Optional: `okf-graph wiki --extractor anthropic` (uv sync --extra anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# 'openai' (default) or 'hash' — hash is a deterministic offline embedder for
# rehearsals without an API key (retrieval quality is meaningless with it)
EMBEDDING_PROVIDER=openai
